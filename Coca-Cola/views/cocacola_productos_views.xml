<odoo>
    <record id="view_cocacola_productos_list" model="ir.ui.view">
        <field name="name">cocacola.productos.list</field>
        <field name="model">cocacola.productos</field>
        <field name="arch" type="xml">
            <list string="Productos Coca-Cola"
                decoration-success="estado == 'activo'"
                decoration-danger="estado == 'agotado'"
                decoration-muted="estado == 'inactivo'">
                <field name="name"/>
                <field name="categoria" widget="badge"
                    decoration-info="categoria == 'gaseosa'"
                    decoration-success="categoria == 'agua'"
                    decoration-warning="categoria == 'jugo'"
                    decoration-muted="categoria == 'bebida_deportiva'"
                    decoration-danger="categoria == 'te_cafe'"/>
                <field name="linea_id"/>
                <field name="tamano"/>
                <field name="precio"/>
                <field name="stock"/>
                <field name="estado" widget="badge"
                    decoration-success="estado == 'activo'"
                    decoration-danger="estado == 'agotado'"
                    decoration-warning="estado == 'inactivo'"/>
            </list>
        </field>
    </record>


<record id="view_cocacola_productos_kanban" model="ir.ui.view">
    <field name="name">cocacola.productos.kanban</field>
    <field name="model">cocacola.productos</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_mobile">
            <field name="name"/>
            <field name="categoria"/>
            <field name="linea_id"/>
            <field name="precio"/>
            <field name="stock"/>
            <field name="estado"/>
            <field name="imagen"/>
            <templates>
                <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_card oe_kanban_global_click
                        #{record.estado.raw_value == 'agotado' ? 'border-danger' :
                        record.estado.raw_value == 'inactivo' ? 'border-secondary' : 'border-success'}">
                        <div class="o_kanban_image">
                            <img t-att-src="kanban_image('cocacola.productos', 'imagen', record.id.raw_value)"
                                alt="Producto"
                                class="o_kanban_image_fill_left"
                                style="width:80px; height:80px; object-fit:cover; border-radius:8px;"/>
                        </div>
                        <div class="oe_kanban_content">
                            <strong><field name="name"/></strong>
                            <div>
                                <field name="linea_id"/> - <field name="tamano"/>
                            </div>
                            <div>
                                <span t-attf-class="badge rounded-pill
                                    #{record.estado.raw_value == 'agotado' ? 'text-bg-danger' :
                                    record.estado.raw_value == 'inactivo' ? 'text-bg-secondary' : 'text-bg-success'}">
                                    <field name="estado"/>
                                </span>
                            </div>
                            <div>
                                <b>$<field name="precio"/></b> - Stock: <field name="stock"/>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>


    <record id="view_cocacola_productos_form" model="ir.ui.view">
        <field name="name">cocacola.productos.form</field>
        <field name="model">cocacola.productos</field>
        <field name="arch" type="xml">
            <form string="Producto Coca-Cola">
                <sheet>
                    <field name="imagen" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="categoria"/>
                            <field name="linea_id"/>
                            <field name="tamano"/>
                        </group>
                        <group>
                            <field name="precio"/>
                            <field name="stock"/>
                            <field name="estado"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="fecha_ingreso"/>
                            <field name="fecha_vencimiento"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_cocacola_productos_search" model="ir.ui.view">
        <field name="name">cocacola.productos.search</field>
        <field name="model">cocacola.productos</field>
        <field name="arch" type="xml">
            <search string="Buscar productos">
                <field name="name"/>
                <field name="linea_id"/>
                <filter string="Activos" name="activos" domain="[('estado','=','activo')]"/>
                <filter string="Agotados" name="agotados" domain="[('estado','=','agotado')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Categoría" name="group_categoria" context="{'group_by':'categoria'}"/>
                    <filter string="Línea" name="group_linea" context="{'group_by':'linea_id'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by':'estado'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_cocacola_productos" model="ir.actions.act_window">
        <field name="name">Productos Coca-Cola</field>
        <field name="res_model">cocacola.productos</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_cocacola_productos_search"/>
    </record>
</odoo>