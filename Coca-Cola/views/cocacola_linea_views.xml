<odoo>
    <record id="view_cocacola_linea_list" model="ir.ui.view">
        <field name="name">cocacola.linea.list</field>
        <field name="model">cocacola.linea</field>
        <field name="arch" type="xml">
            <list string="Líneas de producto">
                <field name="name"/>
                <field name="categoria" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="view_cocacola_linea_form" model="ir.ui.view">
        <field name="name">cocacola.linea.form</field>
        <field name="model">cocacola.linea</field>
        <field name="arch" type="xml">
            <form string="Línea de producto">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="categoria"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_cocacola_linea" model="ir.actions.act_window">
        <field name="name">Líneas de producto</field>
        <field name="res_model">cocacola.linea</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>