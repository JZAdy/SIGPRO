<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de lista -->
    <record id="view_cocacola_empleado_list" model="ir.ui.view">
        <field name="name">cocacola.empleado.list</field>
        <field name="model">cocacola.empleado</field>
        <field name="arch" type="xml">
            <list string="Empleados">
                <field name="nombre"/>
                <field name="apellido"/>
                <field name="edad"/>
                <field name="ocupacion"/>
                <field name="anios_trabajados"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_cocacola_empleado_form" model="ir.ui.view">
        <field name="name">cocacola.empleado.form</field>
        <field name="model">cocacola.empleado</field>
        <field name="arch" type="xml">
            <form string="Empleado">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="apellido"/>
                            <field name="edad"/>
                        </group>
                        <group>
                            <field name="ocupacion"/>
                            <field name="anios_trabajados"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_cocacola_empleado" model="ir.actions.act_window">
        <field name="name">Empleados</field>
        <field name="res_model">cocacola.empleado</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_cocacola_empleado"
            name="Empleados"
            parent="Coca-Cola.menu_cocacola_root"
            action="action_cocacola_empleado"
            sequence="40"/>

</odoo>